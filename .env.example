# Promptly configuration - Gemini 3.1 Flash-Lite has a free API tier, subject to limits.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# For OpenAI, set AI_PROVIDER=openai and configure these instead:
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6-astra
# Optional provider endpoint or database location:
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# DB_PATH=./data/promptly.sqlite
# Exact extension origin for browser-side requests (required for the extension's CORS check).
PROMPTLY_EXTENSION_ORIGIN=chrome-extension://filiepnajkdniickanglihboebcameoc
